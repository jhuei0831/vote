scalar Time
scalar UUID
scalar Uint
scalar Int64
scalar UInt64

directive @hasPermission(
  resource: String!
  action: String!
) on FIELD_DEFINITION

"""
Pagination information for paginated results.
"""
type PageInfo {
  startCursor: String
  endCursor: String
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
}

interface pageQuery {
  first: Int64
  after: String
  last: Int64
  before: String
}